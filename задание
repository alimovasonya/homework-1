#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <limits.h>

#define MAX_RECORDS 100

// Структура одной записи журнала
typedef struct {
    int id;
    int score;
} Result;

/* ============================================================
 * Чтение целого числа (защита от переполнения и букв)
 * Возвращает: 1 - число прочитано, 0 - конец файла, -1 - ошибка
 * ============================================================ */
int read_int(FILE *file, int *value) {
    char token[128];
    char *end;
    long number;

    if (fscanf(file, "%127s", token) != 1) {
        return feof(file) ? 0 : -1;
    }

    errno = 0;
    number = strtol(token, &end, 10);

    // Проверка на переполнение, отсутствие цифр и лишние символы 
    if (errno == ERANGE || end == token || *end != '\0' ||
        number < INT_MIN || number > INT_MAX) {
        return -1;
    }

    *value = (int)number;
    return 1;
}

/* ============================================================
 * Проверка, встречался ли такой id раньше
 * ============================================================ */
int id_exists(Result data[], int size, int id) {
    for (int i = 0; i < size; i++) {
        if (data[i].id == id) {
            return 1;
        }
    }
    return 0;
}

/* ============================================================
 * Загрузка записей из файла results.txt
 * ============================================================ */
int load(Result data[], int *size) {
    FILE *file = fopen("results.txt", "r");

    if (file == NULL) {
        return 0; // Ошибка открытия файла
    }

    *size = 0;

    while (1) {
        int id, score;
        int status = read_int(file, &id);

        if (status == 0) {
            break; // Конец файла
        }

        if (status == -1) {
            fclose(file);
            return 0; // Ошибка чтения id
        }

        status = read_int(file, &score);

        if (status != 1) {
            fclose(file);
            return 0; // Ошибка чтения score (неполная пара)
        }

        // Проверка диапазонов, вместимости, уникальности
        if (id < 1 || id > 9999 ||
            score < 0 || score > 100 ||
            *size >= MAX_RECORDS ||
            id_exists(data, *size, id)) {
            fclose(file);
            return 0; 
        }

        // Сохранение записи
        data[*size].id = id;
        data[*size].score = score;
        (*size)++;
    }

    if (fclose(file) != 0) {
        return 0;
    }

    return 1; // Успешная загрузка
}

/* ============================================================
 * Команда 1: Вывод всех записей
 * ============================================================ */
void show(Result data[], int size) {
    if (size == 0) {
        printf("No data\n");
        return;
    }

    for (int i = 0; i < size; i++) {
        printf("%d %d\n", data[i].id, data[i].score);
    }
}

/* ============================================================
 * Команда 2: Статистика
 * ============================================================ */
void statistics(Result data[], int size) {
    if (size == 0) {
        printf("No data\n");
        return;
    }

    long long sum = 0;
    int passed = 0;
    int min_index = 0;
    int max_index = 0;

    for (int i = 0; i < size; i++) {
        sum += data[i].score;

        if (data[i].score >= 60) {
            passed++;
        }

        // Ищем первый минимум и первый максимум
        if (data[i].score < data[min_index].score) {
            min_index = i;
        }

        if (data[i].score > data[max_index].score) {
            max_index = i;
        }
    }

    printf("Count: %d\n", size);
    printf("Average: %.2f\n", (double)sum / size);
    printf("Score >= 60: %d\n", passed);

    printf("Minimum: %d %d\n", data[min


].id, data[min_index].score);
    printf("Maximum: %d %d\n", data[max_index].id, data[max_index].score);
}

/* ============================================================
 * Команда 3: Поиск записи по id
 * ============================================================ */
void find(Result data[], int size, int id) {
    for (int i = 0; i < size; i++) {
        if (data[i].id == id) {
            printf("Found: %d %d\n", data[i].id, data[i].score);
            return;
        }
    }
    printf("Not found\n");
}

/* ============================================================
 * Команда 4: Индивидуальный вариант 3
 * Вывод записей с баллами от 60 до 80 включительно.
 * ============================================================ */
void individual(Result data[], int size) {
    if (size == 0) {
        printf("No data\n");
        return;
    }

    int found = 0;

    for (int i = 0; i < size; i++) {
        // Условие варианта 3: строго от 60 до 80 включительно
        if (data[i].score >= 60 && data[i].score <= 80) {
            printf("%d %d\n", data[i].id, data[i].score);
            found = 1;
        }
    }

    if (!found) {
        printf("No matches\n");
    }
}

/* ============================================================
 * Команда 5: Сохранение всех записей в report.txt
 * ============================================================ */
int save(Result data[], int size) {
    FILE *file = fopen("report.txt", "w");

    if (file == NULL) {
        return 0;
    }

    int ok = 1;

    for (int i = 0; i < size; i++) {
        if (fprintf(file, "%d %d\n", data[i].id, data[i].score) < 0) {
            ok = 0;
            break;
        }
    }

    if (fclose(file) != 0) {
        ok = 0;
    }

    return ok;
}

/* ============================================================
 * Главная функция (Меню)
 * ============================================================ */
int main(void) {
    Result data[MAX_RECORDS];
    int size = 0;
    int command;

    // Загрузка данных при старте
    if (!load(data, &size)) {
        printf("Load error\n");
        return 1; // Завершение программы по требованию методички
    }

    // Бесконечное меню
    while (1) {
        printf("\n===== MENU =====\n");
        printf("1 - Show all records\n");
        printf("2 - Statistics\n");
        printf("3 - Find by ID\n");
        printf("4 - Individual variant 3\n");
        printf("5 - Save to report.txt\n");
        printf("0 - Exit\n");
        printf("Command: ");

        int status = read_int(stdin, &command);

        if (status == 0) {
            break; // Конец ввода (Ctrl+D)
        }

        if (status == -1) {
            // Буквы вместо команды
            printf("Input error\n");
            return 1; 
        }

        switch (command) {
            case 1:
                show(data, size);
                break;

            case 2:
                statistics(data, size);
                break;

            case 3: {
                int id;
                printf("Enter ID: ");

                // Согласно методичке: "При буквах вместо команды или id выведите Input error и завершитесь"
                if (read_int(stdin, &id) != 1 || id < 1 || id > 9999) {
                    printf("Input error\n");
                    return 1; 
                }

                find(data, size, id);
                break;
            }

            case 4:
                individual(data, size);
                break;

            case 5:
                if (save(data, size)) {
                    printf("Saved successfully\n");
                } else {
                    printf("Save error\n");
                }
                break;

            case 0:
                printf("Program finished\n");
                return 0;

            default:
                // Неизвестная числовая команда
                printf("Unknown command\n");
                break;
        }
    }

    return 0;
}






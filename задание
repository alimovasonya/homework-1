
#include <stdio.h>  // Подключаем библиотеку для ввода и вывода данных
#include <stdlib.h> // Подключаем библиотеку для функции exit()

#define MAX_SIZE 100 // Создаём константу: максимальный размер массива — 100

// Объявляем функции, которые будут использоваться в программе
void inputArray(int array[], int size); // Функция для ввода элементов массива
void printArray(const int array[], int size); // Функция для вывода массива
int findMin(const int array[], int size); // Функция поиска минимального элемента
int findMax(const int array[], int size); // Функция поиска максимального элемента
long long calculateSum(const int array[], int size); // Функция вычисления суммы
double calculateAverage(const int array[], int size); // Функция вычисления среднего
void printCounts(const int array[], int size); // Функция подсчёта положительных, отрицательных и нулевых чисел
void printEvenOdd(const int array[], int size); // Функция подсчёта чётных и нечётных чисел
void printRange(const int array[], int size); // Функция вывода элементов из заданного диапазона
void performIndividualTask(const int array[], int size); // Функция индивидуального задания

// Функция ввода элементов массива
void inputArray(int array[], int size)
{
    for (int i = 0; i < size; i++) // Цикл проходит по всем элементам массива
    {
        printf("Введите элемент %d: ", i + 1); // Просим пользователя ввести число

        if (scanf("%d", &array[i]) != 1) // Проверяем, правильно ли введено целое число
        {
            printf("Ошибка ввода!\n"); // Выводим сообщение об ошибке
            exit(1); // Завершаем программу с кодом ошибки
        }
    }
}

// Функция вывода массива
void printArray(const int array[], int size)
{
    for (int i = 0; i < size; i++) // Перебираем все элементы массива
    {
        printf("%d ", array[i]); // Выводим текущий элемент массива
    }

    printf("\n"); // Переходим на новую строку
}

// Функция поиска минимального элемента
int findMin(const int array[], int size)
{
    int minIndex = 0; // Считаем, что минимальный элемент находится под индексом 0

    for (int i = 1; i < size; i++) // Начинаем проверку со второго элемента
    {
        if (array[i] < array[minIndex]) // Проверяем, меньше ли текущий элемент минимума
        {
            minIndex = i; // Если меньше, запоминаем его индекс
        }
    }

    return minIndex; // Возвращаем индекс минимального элемента
}

// Функция поиска максимального элемента
int findMax(const int array[], int size)
{
    int maxIndex = 0; // Считаем, что максимальный элемент находится под индексом 0

    for (int i = 1; i < size; i++) // Начинаем проверку со второго элемента
    {
        if (array[i] > array[maxIndex]) // Проверяем, больше ли текущий элемент максимума
        {
            maxIndex = i; // Если больше, запоминаем его индекс
        }
    }

    return maxIndex; // Возвращаем индекс максимального элемента
}

// Функция вычисления суммы элементов
long long calculateSum(const int array[], int size)
{
    long long sum = 0; // Создаём переменную суммы и задаём ей значение 0

    for (int i = 0; i < size; i++) // Перебираем все элементы массива
    {
        sum += array[i]; // Прибавляем текущий элемент к общей сумме
    }

    return sum; // Возвращаем полученную сумму
}

// Функция вычисления среднего арифметического
double calculateAverage(const int array[], int size)
{
    return (double)calculateSum(array, size) / size; // Делим сумму на количество элементов и возвращаем результат
}

// Функция подсчёта положительных, отрицательных и нулевых элементов
void printCounts(const int array[], int size)
{
    int positive = 0; // Счётчик положительных чисел
    int negative = 0; // Счётчик отрицательных чисел
    int zero = 0; // Счётчик нулей

    for (int i = 0; i < size; i++) // Перебираем все элементы массива
    {
        if (array[i] > 0) // Если число больше нуля
        {
            positive++; // Увеличиваем счётчик положительных чисел
        }
        else if (array[i] < 0) // Если число меньше нуля
        {
            negative++; // Увеличиваем счётчик отрицательных чисел
        }
        else // Если число не больше и не меньше нуля
        {
            zero++; // Увеличиваем счётчик нулей
        }
    }

    printf("Положительных элементов: %d\n", positive); // Выводим количество положительных чисел
    printf("Отрицательных элементов: %d\n", negative); // Выводим количество отрицательных чисел
    printf("Нулевых элементов: %d\n", zero); // Выводим количество нулей
}

// Функция подсчёта чётных и нечётных элементов
void printEvenOdd(const int array[], int size)
{
    int even = 0; // Счётчик чётных чисел
    int odd = 0; // Счётчик нечётных чисел

    for (int i = 0; i < size; i++) // Перебираем все элементы массива
    {
        if (array[i] % 2 == 0) // Проверяем, делится ли число на 2 без остатка
        {
            even++; // Увеличиваем счётчик чётных чисел
        }
        else // Если число не делится на 2 без остатка
        {
            odd++; // Увеличиваем счётчик нечётных чисел
        }
    }

    printf("Чётных элементов: %d\n", even); // Выводим количество чётных чисел
    printf("Нечётных элементов: %d\n", odd); // Выводим количество нечётных чисел
}

// Функция вывода элементов из диапазона [a, b]
void printRange(const int array[], int size)
{
    int a, b; // Создаём переменные для левой и правой границ диапазона

    printf("Введите границы диапазона a и b: "); // Просим ввести границы

    if (scanf("%d %d", &a, &b) != 2) // Проверяем, введены ли два целых числа
    {
        printf("Ошибка ввода!\n"); // Выводим сообщение об ошибке
        exit(1); // Завершаем программу
    }

    if (a > b) // Проверяем, не больше ли левая граница правой
    {
        printf("Ошибка: левая граница больше правой.\n"); // Сообщаем об ошибке
        return; // Завершаем только эту функцию
    }

    printf("Элементы в диапазоне [%d, %d]: ", a, b); // Выводим выбранный диапазон

    int found = 0; // Переменная показывает, найден ли хотя бы один элемент

    for (int i = 0; i < size; i++) // Перебираем все элементы массива
    {
        if (array[i] >= a && array[i] <= b) // Проверяем, входит ли число в диапазон
        {
            printf("%d ", array[i]); // Выводим подходящий элемент
            found = 1; // Запоминаем, что элемент найден
        }
    }

    if (!found) // Если ни одного подходящего элемента не найдено
    {
        printf("Таких элементов нет"); // Сообщаем, что подходящих элементов нет
    }

    printf("\n"); // Переходим на новую строку
}

// Индивидуальное задание, вариант 3 — локальные максимумы
void performIndividualTask(const int array[], int size)
{
    int found = 0; // Переменная показывает, найден ли локальный максимум

    printf("Локальные максимумы: "); // Выводим название результата

    for (int i = 1; i < size - 1; i++) // Проверяем элементы, кроме первого и последнего
    {
        if (array[i] > array[i - 1] && array[i] > array[i + 1]) // Сравниваем число с левым и правым соседями
        {
            printf("%d (индекс %d) ", array[i], i); // Выводим найденный максимум и его индекс
            found = 1; // Запоминаем, что максимум найден
        }
    }

    if (!found) // Если локальных максимумов нет
    {
        printf("локальных максимумов нет"); // Выводим соответствующее сообщение
    }

    printf("\n"); // Переходим на новую строку
}

// Главная функция программы
int main(void)
{
    int array[MAX_SIZE]; // Создаём массив на 100 целых чисел
    int size; // Переменная для хранения фактического размера массива

    printf("Введите размер массива от 1 до %d: ", MAX_SIZE); // Просим ввести размер массива

    if (scanf("%d", &size) != 1 || size < 1 || size > MAX_SIZE) // Проверяем правильность ввода и допустимый размер
    {
        printf("Ошибка: недопустимый размер массива.\n"); // Выводим сообщение об ошибке
        return 1; // Завершаем программу с кодом ошибки
    }

    inputArray(array, size); // Вызываем функцию ввода массива

    printf("\nИсходный массив: "); // Выводим подпись перед массивом
    printArray(array, size); // Вызываем функцию вывода массива

    int minIndex = findMin(array, size); // Получаем индекс минимального элемента
    int maxIndex = findMax(array, size); // Получаем индекс максимального элемента

    printf("\nМинимальный элемент: %d\n", array[minIndex]); // Выводим минимальное число
    printf("Первый индекс минимума: %d\n", minIndex); // Выводим его индекс

    printf("Максимальный элемент: %d\n", array[maxIndex]); // Выводим максимальное число
    printf("Первый индекс максимума: %d\n", maxIndex); // Выводим его индекс

    printf("\nСумма элементов: %lld\n", calculateSum(array, size)); // Вычисляем и выводим сумму

    printf("Среднее арифметическое: %.2f\n", calculateAverage(array, size)); // Вычисляем и выводим среднее с двумя знаками после запятой

    printCounts(array, size); // Вызываем функцию подсчёта положительных, отрицательных и нулевых чисел

    printEvenOdd(array, size); // Вызываем функцию подсчёта чётных и нечётных чисел

    printRange(array, size); // Вызываем функцию вывода элементов из заданного диапазона

    performIndividualTask(array, size); // Выполняем индивидуальное задание — поиск локальных максимумов

    return 0; // Завершаем программу успешно
}
